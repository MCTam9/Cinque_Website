# ─────────────────────────────────────────────────────────────
# Cinque Storefront — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# RULE: Only variables that are safe to expose in the browser bundle
# may be prefixed with NEXT_PUBLIC_. Everything else is server-only and
# must NOT carry that prefix.
# ─────────────────────────────────────────────────────────────

# ── Client-safe (exposed to the browser) ──────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
# Public site origin, used to build Stripe return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ───────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Sanity write token (Editor/robot). Used only by the webhook to deduct
# inventory and create order documents. Keep server-side only.
SANITY_API_WRITE_TOKEN=sk_sanity_write_xxx

# Optional: read-only token for storefront reads. Falls back to the write
# token above if unset, but a dedicated read token is preferred in production.
SANITY_API_READ_TOKEN=sk_sanity_read_xxx

# Secret used to authenticate the Sanity → Next revalidation webhook.
# REQUIRED in production: without it /api/revalidate rejects every delivery,
# and published edits only reach cached pages when they next expire.
SANITY_REVALIDATE_SECRET=change_me

# Secret for the Sanity → Stripe product/price sync webhook (see README).
SANITY_STRIPE_SYNC_SECRET=change_me

# Secret for the Sanity order-update webhook that emails shipping notices.
# (You may reuse the same value for all three Sanity webhooks if you prefer.)
SANITY_ORDER_WEBHOOK_SECRET=change_me

# ── Transactional email (Resend) ──
# Get a key at resend.com. FROM must be a verified domain/sender.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Cinque <orders@yourdomain.com>
# Where internal low-stock restock reminders are sent.
OPS_ALERT_EMAIL=ops@yourdomain.com

# ── Shipping (ShipStation — placeholder) ──
# SHIPSTATION_API_KEY=
# SHIPSTATION_API_SECRET=
